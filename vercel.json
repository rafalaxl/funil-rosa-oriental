{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rosaoriental-oficial.vercel.app"
        }
      ],
      "destination": "/vendas.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rosa-oriental-zeta.vercel.app"
        }
      ],
      "destination": "/vendas.html"
    },
    {
      "source": "/",
      "destination": "/artigo.html"
    }
  ]
}
